<Window x:Class="ImAged.MVVM.View.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="400"
        Height="500"
        Background="#1E1E1E"
        AllowsTransparency="True"
        WindowStyle="None">

        <Border CornerRadius="15"
                Background="#222"
                BorderBrush="#FF6A00"
                BorderThickness="1"
                Padding="30">
                <Grid VerticalAlignment="Center"
                      HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title -->
                        <TextBlock Text="Sign In"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,40"/>

                        <!-- Username -->
                        <StackPanel Grid.Row="1"
                                    Margin="0,0,0,20">
                                <TextBlock Text="Email or Username"
                                           FontSize="14"
                                           Foreground="#BBBBBB"/>
                                <TextBox x:Name="UsernameTextBox"
                                         Height="40"
                                         Margin="0,5,0,0"
                                         Background="#333"
                                         Foreground="White"
                                         BorderThickness="0"
                                         Padding="10"
                                         FontSize="14"/>
                        </StackPanel>

                        <!-- Password -->
                        <StackPanel Grid.Row="2"
                                    Margin="0,0,0,20">
                                <TextBlock Text="Password"
                                           FontSize="14"
                                           Foreground="#BBBBBB"/>
                                <PasswordBox x:Name="PasswordBox"
                                             Height="40"
                                             Margin="0,5,0,0"
                                             Background="#333"
                                             Foreground="White"
                                             BorderThickness="0"
                                             Padding="10"
                                             FontSize="14"/>
                        </StackPanel>

                        <!-- Login Button -->
                        <Button Grid.Row="3"
                                Content="Login"
                                Height="45"
                                Background="#FF6A00"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Login_Click"/>
                </Grid>
        </Border>
</Window>
